{
    "authors": [
        {
            "email": "nahid@zerofyi.in",
            "homepage": "https://github.com/zerofyi",
            "name": "Nahid Hassan",
            "role": "Creator"
        }
    ],
    "autoload": {
        "psr-4": {
            "Zerofyi\\ShipIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zerofyi\\ShipIt\\Tests\\": "tests/"
        }
    },
    "description": "A zero-dependency dual-protocol deployment wizard for Hostinger shared hosting (push:github + push:hostinger) with pre-deploy backups, one-command rollback and selective file deployments.",
    "extra": {
        "laravel": {
            "providers": [
                "Zerofyi\\ShipIt\\ShipItServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel",
        "hostinger",
        "deployment",
        "git",
        "ssh",
        "rollback",
        "backup"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "name": "zerofyi/shipit",
    "prefer-stable": true,
    "require": {
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/process": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "php": "^8.1"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "type": "library"
}
